# Copy to .env.migration or unified_migration/.env and replace placeholders locally.
# Never commit credentials.

MIGRATION_DATABASE_URL=postgresql+psycopg://your_username:your_password@your_host:5432/oppttest
MIGRATION_SOURCE_SCHEMA=chemdash
MIGRATION_CONTROL_SCHEMA=chemdash
MIGRATION_BATCH_TABLE=unified_migration_batches
MIGRATION_RUN_TABLE=unified_migration_runs

# Optional PostgreSQL A -> PostgreSQL B transfer settings.
MIGRATION_TRANSFER_SOURCE_DATABASE_URL=postgresql+psycopg://your_username:your_password@localhost:5432/oppttest
MIGRATION_TRANSFER_DESTINATION_DATABASE_URL=postgresql+psycopg://your_username:your_password@your_aws_host:5432/oppttest?sslmode=require
MIGRATION_TRANSFER_RUN_TABLE=unified_transfer_runs
MIGRATION_TRANSFER_BATCH_TABLE=unified_transfer_batches
